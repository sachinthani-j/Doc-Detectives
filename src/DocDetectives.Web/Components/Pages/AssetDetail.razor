@page "/assets/view"
@page "/asset"
@inject IAssetCatalogGateway Catalog
@inject IKnowledgeIndex Knowledge
@inject IPmModelGateway PmModels

<PageTitle>@(_asset?.Name ?? "Asset") · Doc Detectives</PageTitle>

<div class="page">
    <a class="btn btn-ghost btn-sm" href="assets" style="margin-bottom:1rem"><Icon Name="arrow-left" Size="15" /> Assets</a>

    @if (_loading)
    {
        <div class="card card-pad stack-sm">
            <div class="skeleton" style="width:40%;height:22px"></div>
            <div class="skeleton" style="width:25%"></div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger"><Icon Name="alert" /> <div>@_error</div></div>
    }
    else if (_asset is null)
    {
        <div class="card">
            <div class="empty">
                <div class="icon-wrap"><Icon Name="box" /></div>
                <h3>Asset not found</h3>
                <p>No asset with id <span class="mono">@Id</span> exists in the catalog.</p>
            </div>
        </div>
    }
    else
    {
        <div class="page-head">
            <div class="grow">
                <div class="eyebrow">Asset <span class="mono">@_asset.Id</span></div>
                <h1>@(string.IsNullOrEmpty(_asset.Name) ? "(no description)" : _asset.Name)</h1>
            </div>
            <a class="btn btn-primary" href="@UiText.AskUrl(_asset.Id)"><Icon Name="chat" Size="16" /> Ask about this asset</a>
        </div>

        <div class="stack">
            <div class="card card-pad">
                <dl class="facts" style="margin:0">
                    <Fact Label="Manufacturer" Value="@_asset.Manufacturer" />
                    <Fact Label="Model" Value="@_asset.ModelNumber" />
                    <Fact Label="Serial number" Value="@_asset.SerialNumber" Mono="true" />
                    <Fact Label="Type" Value="@_asset.Category" />
                </dl>
                @if (_parent is not null)
                {
                    <p class="subtle" style="margin-top:1rem">
                        Part of <a href="@UiText.AssetUrl(_parent.Id)">@_parent.Name</a> <span class="tag">@_parent.Id</span>
                    </p>
                }
            </div>

            @if (_children.Count > 0 || _asset.SpareParts is { Count: > 0 })
            {
                <div class="card">
                    <div class="card-head"><h2>Structure &amp; spare parts</h2></div>
                    <div class="card-body">
                        <AssetTree Items="TreeAssets" />
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-head"><h2>Periodical maintenance</h2></div>
                @if (_pmError is not null)
                {
                    <div class="card-body"><div class="alert alert-danger"><Icon Name="alert" /> <div>@_pmError</div></div></div>
                }
                else
                {
                    <PmModelList Models="_pmModels" AssetId="@_asset.Id" />
                }
            </div>

            <div class="card">
                <div class="card-head">
                    <h2>Linked manuals</h2>
                    <a class="btn btn-sm" href="upload"><Icon Name="plus" Size="14" /> Upload a manual</a>
                </div>
                @if (_manuals.Count == 0)
                {
                    <div class="empty">
                        <div class="icon-wrap"><Icon Name="file" /></div>
                        <h3>No manuals linked yet</h3>
                        <p>When an uploaded manual matches this asset, it appears here.</p>
                    </div>
                }
                else
                {
                    <div class="file-list">
                        @foreach (var m in _manuals)
                        {
                            <a class="file-row file-link" href="@UiText.DocumentUrl(m.ManualId)">
                                <FileIcon FileName="@m.FileName" />
                                <div class="grow">
                                    <div class="truncate" style="font-weight:550">@m.FileName</div>
                                    <div class="subtle">@m.SectionCount indexed section@(m.SectionCount == 1 ? "" : "s")</div>
                                </div>
                                <span class="subtle nowrap">Open <Icon Name="arrow-right" Size="14" /></span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? Id { get; set; }

    private Asset? _asset;
    private IReadOnlyList<ManualReference> _manuals = [];
    private IReadOnlyList<Asset> _children = [];
    private Asset? _parent;
    private IReadOnlyList<PmModel> _pmModels = [];
    private string? _pmError;

    // The asset itself as the tree root (shown without its parent link), followed by its direct children.
    private IReadOnlyList<Asset> TreeAssets =>
        _asset is null ? [] : [_asset with { ParentAssetId = null }, .. _children];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(Id))
            {
                _asset = null;
                return;
            }

            _asset = await Catalog.GetAssetByIdAsync(Id);
            if (_asset is null)
            {
                _manuals = [];
                _children = [];
                _parent = null;
                return;
            }

            var manuals = Knowledge.GetManualsForAssetAsync(_asset.Id);
            var children = Catalog.GetChildAssetsAsync(_asset.Id);
            var parent = string.IsNullOrWhiteSpace(_asset.ParentAssetId)
                ? Task.FromResult<Asset?>(null)
                : Catalog.GetAssetByIdAsync(_asset.ParentAssetId);

            var pmModels = LoadPmModelsAsync(_asset.Id);

            await Task.WhenAll(manuals, children, parent, pmModels);
            _manuals = manuals.Result;
            _children = children.Result;
            _parent = parent.Result;
        }
        catch (Exception ex)
        {
            _error = $"Could not load the asset: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // Loaded on its own, so a PM model index problem never hides the rest of the asset page.
    private async Task LoadPmModelsAsync(string assetId)
    {
        _pmError = null;
        try { _pmModels = await PmModels.GetForAssetAsync(assetId); }
        catch (Exception ex)
        {
            _pmModels = [];
            _pmError = $"Could not load the PM models: {ex.Message}";
        }
    }
}
