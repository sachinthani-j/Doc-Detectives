@page "/ask"
@implements IDisposable
@inject TechnicalManualQaSkill Qa
@inject IAssetCatalogGateway Catalog
@inject NavigationManager Nav

<PageTitle>Ask the manuals · Doc Detectives</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <div class="eyebrow">Technician assistant</div>
            <h1>Ask the manuals</h1>
        </div>
    </div>

    <div class="chat-layout">
        @* @key gives a fresh conversation whenever the scope changes. *@
        <ChatPanel @key="@(_asset?.Id ?? "*")"
                   Prepare="PrepareAsync"
                   Title="@(_asset is null ? "All manuals" : _asset.Name)"
                   EmptyTitle="@(_asset is null ? "Ask anything from the uploaded manuals" : $"Ask about {_asset.Name}")"
                   Placeholder="@(_asset is null ? "Ask a question about any manual…" : $"Ask about {_asset.Id}…")" />

        <aside class="card card-pad scope-card stack">
            <div>
                <h3>Scope</h3>
                <p class="subtle" style="margin-top:.2rem">Limit answers to manuals linked to one asset, or search everything.</p>
            </div>

            <div class="scope-current">
                @if (_asset is null)
                {
                    <span class="icon-tile" style="color:var(--accent-text)"><Icon Name="globe" /></span>
                    <div class="grow">
                        <div style="font-weight:600">All manuals</div>
                        <div class="subtle">Every uploaded manual is searched.</div>
                    </div>
                }
                else
                {
                    <span style="color:var(--accent-text)"><Icon Name="box" /></span>
                    <div class="grow" style="min-width:0">
                        <div style="font-weight:600" class="truncate" title="@_asset.Name">@_asset.Name</div>
                        <div class="subtle mono">@_asset.Id</div>
                        <div class="subtle">@string.Join(" · ", new[] { _asset.Manufacturer, _asset.ModelNumber }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                    </div>
                    <button class="btn btn-ghost btn-sm btn-icon" style="width:30px" title="Search all manuals instead" @onclick="ClearAsset"><Icon Name="x" Size="15" /></button>
                }
            </div>

            @if (_assetNotFound is not null)
            {
                <div class="alert alert-warn"><Icon Name="alert" /> <div>Asset <span class="mono">@_assetNotFound</span> was not found.</div></div>
            }

            <div class="picker">
                <label class="subtle" for="asset-picker">Change asset</label>
                <input id="asset-picker" class="input" style="margin-top:.3rem" placeholder="Search by name or model…"
                       value="@_pickerText" @oninput="OnPickerInput" autocomplete="off" />
                @if (_pickerResults.Count > 0)
                {
                    <div class="picker-list">
                        @foreach (var a in _pickerResults)
                        {
                            <button class="picker-item" @onclick="@(() => SelectAsset(a))">
                                <div class="truncate" style="font-weight:550">@(string.IsNullOrEmpty(a.Name) ? "(no description)" : a.Name)</div>
                                <div class="subtle"><span class="mono">@a.Id</span> @(string.IsNullOrEmpty(a.Manufacturer) ? "" : $"· {a.Manufacturer}")</div>
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_asset is not null)
            {
                <a class="btn btn-sm" href="@UiText.AssetUrl(_asset.Id)">View asset details <Icon Name="arrow-right" Size="14" /></a>
            }
        </aside>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "asset")] public string? AssetParam { get; set; }

    private Asset? _asset;
    private string? _assetNotFound;

    private string _pickerText = "";
    private IReadOnlyList<Asset> _pickerResults = [];
    private CancellationTokenSource? _pickerCts;
    private string? _loadedParam;

    protected override async Task OnParametersSetAsync()
    {
        if (AssetParam == _loadedParam) return;
        _loadedParam = AssetParam;
        _assetNotFound = null;

        if (string.IsNullOrWhiteSpace(AssetParam))
        {
            _asset = null;
            return;
        }

        try
        {
            _asset = await Catalog.GetAssetByIdAsync(AssetParam);
            if (_asset is null) _assetNotFound = AssetParam;
        }
        catch
        {
            _asset = null;
            _assetNotFound = AssetParam;
        }
    }

    private Task<QaContext> PrepareAsync(string question, CancellationToken cancellationToken) =>
        Qa.PrepareAsync(_asset?.Id, question, cancellationToken: cancellationToken);

    private async Task OnPickerInput(ChangeEventArgs e)
    {
        _pickerText = e.Value?.ToString() ?? "";
        _pickerCts?.Cancel();
        _pickerCts = new CancellationTokenSource();
        var token = _pickerCts.Token;

        if (_pickerText.Trim().Length < 2)
        {
            _pickerResults = [];
            return;
        }

        try
        {
            await Task.Delay(300, token); // debounce while typing
            var results = await Catalog.SearchAssetsAsync(null, _pickerText.Trim(), token);
            if (!token.IsCancellationRequested) _pickerResults = results.Take(8).ToList();
        }
        catch (OperationCanceledException) { }
        catch { _pickerResults = []; }
    }

    private void SelectAsset(Asset asset)
    {
        _pickerText = "";
        _pickerResults = [];
        Nav.NavigateTo(UiText.AskUrl(asset.Id));
    }

    private void ClearAsset() => Nav.NavigateTo("ask");

    public void Dispose() => _pickerCts?.Cancel();
}
