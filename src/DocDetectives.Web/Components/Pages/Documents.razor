@page "/documents"
@inject IKnowledgeIndex Knowledge
@inject IngestionJobService Jobs
@inject NavigationManager Nav

<PageTitle>Documents · Doc Detectives</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <div class="eyebrow">Library</div>
            <h1>Documents</h1>
            <p class="muted">Every manual that has been uploaded. Open one to preview it and chat about it.</p>
        </div>
        <a class="btn" href="upload"><Icon Name="upload" Size="16" /> Upload documents</a>
    </div>

    <div class="row" style="margin-bottom:1.25rem">
        <div class="search grow">
            <span class="search-icon"><Icon Name="search" /></span>
            <input class="input" @bind="_filter" @bind:event="oninput" placeholder="Filter by file name or asset id…" aria-label="Filter documents" />
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" style="margin-bottom:1rem"><Icon Name="alert" /> <div>@_error</div></div>
    }

    @* Hidden while the Upload page hides the manuals-folder list (nothing to click there to process these files). *@
    @if (ShowNotProcessedBanner && _notIngested.Count > 0)
    {
        <div class="alert alert-info" style="margin-bottom:1rem">
            <Icon Name="file" />
            <div class="grow">
                @_notIngested.Count file@(_notIngested.Count == 1 ? " is" : "s are") in the manuals folder but not uploaded for processing yet.
                <a href="upload">Process them</a>
            </div>
        </div>
    }

    <div class="card">
        @if (_documents is null)
        {
            <div class="card-body stack-sm">
                @for (var i = 0; i < 6; i++) { <div class="skeleton" style="width:@(85 - i * 6)%"></div> }
            </div>
        }
        else if (_documents.Count == 0)
        {
            <div class="empty">
                <div class="icon-wrap"><Icon Name="file" /></div>
                <h3>No documents yet</h3>
                <p>Upload a manual and it will show up here.</p>
                <p style="margin-top:1rem"><a class="btn btn-sm btn-primary" href="upload">Upload documents</a></p>
            </div>
        }
        else
        {
            var shown = Filtered.ToList();
            <div class="card-head">
                <span class="subtle">@shown.Count of @_documents.Count document@(_documents.Count == 1 ? "" : "s")</span>
            </div>
            @if (shown.Count == 0)
            {
                <div class="empty" style="padding:2rem 1rem"><p>No documents match “@_filter”.</p></div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th class="hide-sm">Linked assets</th>
                                <th class="hide-sm">Sections</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in shown)
                            {
                                var onDisk = _filesOnDisk.Contains(d.FileName);
                                <tr class="clickable" @onclick="@(() => Nav.NavigateTo(UiText.DocumentUrl(d.ManualId)))">
                                    <td>
                                        <div class="row" style="gap:.65rem">
                                            <FileIcon FileName="@d.FileName" />
                                            <div class="grow">
                                                <div class="asset-name truncate doc-name" title="@d.FileName">@d.FileName</div>
                                                @if (!onDisk) { <div class="subtle">File not in the manuals folder; preview unavailable</div> }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="hide-sm">
                                        @if (d.AssetIds is { Count: > 0 } ids)
                                        {
                                            @foreach (var id in ids.Take(2))
                                            {
                                                <span class="tag" style="margin:0 .25rem .2rem 0" title="@id">@id</span>
                                            }
                                            @if (ids.Count > 2) { <span class="subtle">+@(ids.Count - 2)</span> }
                                        }
                                        else
                                        {
                                            <span class="subtle">Not linked</span>
                                        }
                                    </td>
                                    <td class="hide-sm subtle">@d.SectionCount</td>
                                    <td style="text-align:right" class="nowrap">
                                        <a class="btn btn-sm btn-ghost" href="@UiText.DocumentUrl(d.ManualId)" @onclick:stopPropagation="true">
                                            Open <Icon Name="arrow-right" Size="14" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<ManualReference>? _documents;
    private HashSet<string> _filesOnDisk = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _notIngested = [];
    private static readonly bool ShowNotProcessedBanner = false;
    private string _filter = "";
    private string? _error;

    private IEnumerable<ManualReference> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _documents ?? []
            : (_documents ?? []).Where(d =>
                d.FileName.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
                || (d.AssetIds?.Any(a => a.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _filesOnDisk = Jobs.GetManualFiles().Select(f => f.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _documents = await Knowledge.ListManualsAsync();

            var ingested = _documents.Select(d => d.FileName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _notIngested = _filesOnDisk.Where(f => !ingested.Contains(f)).ToList();
        }
        catch (Exception ex)
        {
            _error = $"Could not load documents: {ex.Message}";
            _documents = [];
        }
    }
}
