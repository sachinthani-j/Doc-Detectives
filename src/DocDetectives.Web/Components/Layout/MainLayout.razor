@inherits LayoutComponentBase
@implements IDisposable
@inject IngestionJobService Jobs
@* Created with the layout so every page visited in this tab is recorded for the back button. *@
@inject NavigationHistory History

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="">
            <span class="brand-mark"><Icon Name="magnifier-doc" Size="19" Stroke="2" /></span>
            <span>
                <span class="brand-name">Doc Detectives</span><br />
                <span class="brand-sub">Manual intelligence</span>
            </span>
        </a>

        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" /><span class="label">Overview</span></NavLink>
            <NavLink href="assets"><Icon Name="box" /><span class="label">Assets</span></NavLink>
            <NavLink href="documents"><Icon Name="file" /><span class="label">Documents</span></NavLink>
            <NavLink href="upload">
                <Icon Name="upload" /><span class="label">Upload manuals</span>
                @if (_activeJobs > 0)
                {
                    <span class="badge-count" title="Manuals being processed">@_activeJobs</span>
                }
            </NavLink>
        </nav>

        <div class="sidebar-bottom">
            <ThemeToggle />
        </div>
    </aside>

    <main class="main">
        @Body
    </main>
</div>

@* Ask the manuals: chat button in the bottom-right corner, opening a panel on the right. *@
<ChatDrawer />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private int _activeJobs;

    protected override void OnInitialized()
    {
        Jobs.Changed += OnJobsChanged;
        Count();
    }

    private void Count() =>
        _activeJobs = Jobs.Jobs.Count(j => j.Status is IngestionJobStatus.Queued or IngestionJobStatus.Running);

    private void OnJobsChanged()
    {
        Count();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Jobs.Changed -= OnJobsChanged;
}
