@* Review step for one processed document: approve or reject the proposed new assets, then each drafted PM model (PM jobs with their lines).
   Mirrors the console's AssetProposalReview / JobPlanReview (without editing). Nothing is written until approved. *@
@inject IngestionJobService Jobs

@if (Doc is null) { return; }

@if (Doc.Characteristics is { } chars)
{
    <div class="stack-sm">
        <h3>Characteristics</h3>
        <p class="subtle">@chars.Note</p>
        @if (chars.Filled.Count > 0)
        {
            <div class="char-grid">
                @foreach (var c in chars.Filled)
                {
                    <div class="char"><span class="char-name">@c.Name</span><span class="char-val">@Format(c)</span></div>
                }
            </div>
        }
    </div>
}
else if (Doc.Manual is not null)
{
    @* Characteristics were skipped during upload: extract them on request and save only after consent. *@
    var charDraft = Job.CharacteristicDraft;
    var charDecision = Job.CharacteristicDecision;
    var targetAsset = Job.CharacteristicsAssetId;
    var pendingSave = charDraft is { WouldFill.Count: > 0 } && charDecision == ReviewDecision.Pending;
    var shownValues = charDecision == ReviewDecision.Approved ? Job.SavedCharacteristics?.Filled
                    : charDecision == ReviewDecision.Pending ? charDraft?.WouldFill
                    : null;
    var canExtract = targetAsset is not null && charDecision != ReviewDecision.Approved && !pendingSave;
    <div class="review-card @(pendingSave ? "pending" : null)">
        <div class="review-head">
            <div class="grow">
                <h3>Characteristics</h3>
                <p class="subtle">
                    @if (charDecision == ReviewDecision.Approved && Job.SavedCharacteristics is { } saved) { @saved.Note }
                    else if (charDecision == ReviewDecision.Rejected) { <span>Discarded; nothing was saved.</span> }
                    else if (charDraft is not null) { @charDraft.Note }
                    else if (targetAsset is null) { <span>Link an asset above (or approve the new asset proposal) to fill its characteristics from this manual.</span> }
                    else { <span>Not extracted yet, to keep the upload fast. Extract them to review the values for asset <span class="mono">@targetAsset</span>; nothing is saved without your OK.</span> }
                </p>
            </div>
            @if (charDraft is { WouldFill.Count: > 0 }) { <DecisionBadge Decision="charDecision" /> }
        </div>

        @if (shownValues is { Count: > 0 })
        {
            <div class="char-grid">
                @foreach (var c in shownValues)
                {
                    <div class="char"><span class="char-name">@c.Name</span><span class="char-val">@Format(c)</span></div>
                }
            </div>
        }

        @if (pendingSave)
        {
            <div class="row">
                <button class="btn btn-primary btn-sm" disabled="@_charBusy" @onclick="SaveCharacteristicsAsync">
                    @if (_charBusy) { <span class="spinner"></span> } else { <Icon Name="check" Size="14" /> } Save to asset
                </button>
                <button class="btn btn-sm" disabled="@_charBusy" @onclick="@(() => Jobs.DiscardCharacteristics(Job))"><Icon Name="x" Size="14" /> Discard</button>
            </div>
        }
        else if (canExtract)
        {
            <div class="row">
                <button class="btn btn-sm" disabled="@_charBusy" @onclick="ExtractCharacteristicsAsync">
                    @if (_charBusy) { <span class="spinner"></span> }
                    @(charDraft is null ? "Extract characteristics" : "Extract again")
                </button>
                @if (_charBusy) { <span class="subtle">This can take about half a minute.</span> }
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Doc.ManufacturerDetailsNote))
{
    <p class="subtle">Asset details: @Doc.ManufacturerDetailsNote</p>
}

@if (Job.CurrentProposal is { } proposal)
{
    @* Shown as changed in the chat, when it was. *@
    var decision = Job.AssetProposalDecision;
    var newCount = proposal.NewAssets.Count;
    var mapsOntoExisting = proposal.IsExisting(proposal.Assets[0].Id);
    <div class="review-card @(decision == ReviewDecision.Pending ? "pending" : null)">
        <div class="review-head">
            <div class="grow">
                <h3>@(mapsOntoExisting ? "Asset structure from the manual" : "New asset proposal")</h3>
                <p class="subtle">
                    @if (mapsOntoExisting)
                    {
                        <span>The manual matched existing asset <a class="mono" href="@UiText.AssetUrl(proposal.Assets[0].Id)">@proposal.Assets[0].Id</a>.
                        Existing assets are only linked, never changed; approving creates the @newCount new sub-asset@(newCount == 1 ? "" : "s").</span>
                    }
                    else
                    {
                        <span>Nothing is created until you approve. @newCount new asset@(newCount == 1 ? "" : "s"),
                        @proposal.Assets.Sum(a => a.SpareParts?.Count ?? 0) spare part(s),
                        @proposal.Characteristics.Count characteristic(s).</span>
                    }
                </p>
            </div>
            <DecisionBadge Decision="decision" />
        </div>

        <AssetStructureChart Items="proposal.Assets" ExistingIds="proposal.ExistingAssetIds" ShowSummary="true" />

        @if (proposal.NewAssets.Any(a => a.SpareParts is { Count: > 0 }))
        {
            <details class="parts-details">
                <summary class="subtle">Spare parts on the new assets (@proposal.NewAssets.Sum(a => a.SpareParts?.Count ?? 0))</summary>
                <AssetTree Items="proposal.NewAssets" />
            </details>
        }

        @if (proposal.Characteristics.Count > 0)
        {
            <div class="char-grid">
                @foreach (var c in proposal.Characteristics)
                {
                    <div class="char" title="@c.SourceText"><span class="char-name">@c.Name</span><span class="char-val">@Format(c)</span></div>
                }
            </div>
        }

        @if (decision == ReviewDecision.Pending)
        {
            <div class="row">
                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="ApproveProposalAsync">
                    @if (_busy) { <span class="spinner"></span> } else { <Icon Name="check" Size="14" /> }
                    @(mapsOntoExisting ? $"Approve & create {newCount} new" : "Approve & create")
                </button>
                <button class="btn btn-sm" disabled="@_busy" @onclick="@(() => Jobs.RejectAssetProposal(Job))"><Icon Name="x" Size="14" /> Reject</button>
            </div>
        }
    </div>
}

@if (Doc.JobPlans is { } plans)
{
    <div class="stack-sm">
        <h3>PM models</h3>
        @if (plans.Plans.Count == 0)
        {
            // Same header as when PM models were found, in grey, with the reason underneath.
            <div class="pm-group empty">
                <div class="pm-group-head">
                    <span class="pm-group-icon"><Icon Name="layers" Size="18" /></span>
                    <div class="grow">
                        <div class="pm-group-title">No PM models identified for this asset</div>
                        <div class="subtle">@NoPmReason(plans.Note)</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            // Only a summary at first; the PM models, PM jobs and lines are shown when asked for.
            var pending = plans.Plans.Count(p => Job.PlanDecision(p) == ReviewDecision.Pending);
            var targets = Job.PmModelAssetIds(plans.Plans[0]);
            <div class="pm-group @(_showPlans ? "open" : null)">
                <div class="pm-group-head">
                    <span class="pm-group-icon"><Icon Name="file" Size="18" /></span>
                    <div class="grow">
                        <div class="pm-group-title">
                            We identified @plans.Plans.Count PM model(s) that can be created
                            @if (targets.Count == 1) { <span>for asset <a class="mono" href="@UiText.AssetUrl(targets[0])">@targets[0]</a></span> }
                            else if (targets.Count > 1) { <span>for each of @targets.Count assets</span> }
                        </div>
                        @if (targets.Count > 1)
                        {
                            <div class="pm-group-assets">
                                @foreach (var t in targets) { <a class="tag" href="@UiText.AssetUrl(t)" title="@t">@t</a> }
                            </div>
                        }
                        @if (Job.PmModelsWaitForSelection)
                        {
                            <div class="subtle">Save the asset selection above to choose which assets get these PM models.</div>
                        }
                        <div class="subtle">
                            @plans.Plans.Sum(p => p.Lines.Count) line(s) in total
                            · @(pending == 0 ? "all reviewed" : $"{pending} waiting for your review")
                        </div>
                    </div>
                    <button class="btn btn-sm @(_showPlans ? null : "btn-primary")" @onclick="@(() => _showPlans = !_showPlans)">
                        @(_showPlans ? "Hide PM models" : "Show PM models")
                    </button>
                </div>

                @if (_showPlans)
                {
                    <div class="pm-group-body">
                        @if (Job.PmModelsWaitForSelection)
                        {
                            <div class="alert alert-info"><Icon Name="alert" /> <div>Save the asset selection first: each PM model is created on every selected asset.</div></div>
                        }
                        else if (!IngestionJobService.CanReviewPlans(Job))
                        {
                            <div class="alert alert-info"><Icon Name="alert" /> <div>Decide on the new asset proposal first, so PM models only link to assets that exist.</div></div>
                        }

                        @foreach (var original in plans.Plans)
                        {
            // The draft as changed in the chat, when it was (same Id, so decisions still match).
            var draft = Job.CurrentPlan(original);
            var decision = Job.PlanDecision(draft);
            var expanded = _expandedPlans.Contains(draft.Id);
            // What approving creates: the PM model with one PM job per piece of equipment.
            // Same PM jobs and lines on every linked asset, so the first one shows what each asset gets.
            var preview = Job.CreatedPmModels.GetValueOrDefault(draft.Id)?.FirstOrDefault()
                          ?? PmModelBuilder.Build(draft with { AssetId = draft.AssetId ?? Job.PmModelAssetIds(draft).FirstOrDefault() });
            <div class="review-card @(decision == ReviewDecision.Pending ? "pending" : null)">
                <div class="review-head">
                    <span class="pm-model-icon"><Icon Name="layers" Size="18" /></span>
                    <div class="grow">
                        <div class="pm-model-title">@draft.Title @if (Job.EditedPlans.ContainsKey(draft.Id)) { <span class="badge badge-info">edited</span> }</div>
                        <div class="pm-model-meta">
                            <span class="tag" title="@draft.Id">@draft.Id</span>
                            @if (!string.IsNullOrWhiteSpace(draft.Interval)) { <span class="pm-pill freq"><Icon Name="clock" Size="13" /> @Every(draft.Interval)</span> }
                            <span class="pm-pill">@(preview?.Jobs.Count ?? 0) PM job(s)</span>
                            <span class="pm-pill insp"><Icon Name="clipboard" Size="13" /> @draft.Lines.Count(l => l.LineType == JobPlanLineType.Inspection)</span>
                            @if (draft.Lines.Any(l => l.LineType == JobPlanLineType.Task)) { <span class="pm-pill task"><Icon Name="wrench" Size="13" /> @draft.Lines.Count(l => l.LineType == JobPlanLineType.Task)</span> }
                            @{ var draftTargets = Job.PmModelAssetIds(draft); }
                            @if (draftTargets.Count == 1) { <a class="subtle mono" href="@UiText.AssetUrl(draftTargets[0])">@draftTargets[0]</a> }
                            else if (draftTargets.Count > 1) { <span class="subtle">on @draftTargets.Count assets</span> }
                        </div>
                    </div>
                    <DecisionBadge Decision="decision" />
                    <button class="btn btn-sm pm-toggle @(expanded ? "on" : null)" aria-expanded="@(expanded ? "true" : "false")" @onclick="@(() => TogglePlan(draft.Id))">
                        @(expanded ? "Hide PM jobs" : "PM jobs") <span class="pm-chevron"><Icon Name="chevron-down" Size="15" /></span>
                    </button>
                </div>

                @if (expanded && preview is not null)
                {
                    <PmJobList Jobs="preview.Jobs" />
                }

                @if (decision == ReviewDecision.Approved && Job.CreatedPmModels.GetValueOrDefault(draft.Id) is { Count: > 0 } created)
                {
                    <div class="subtle">
                        <Icon Name="check" Size="14" /> Created @created.Count PM model(s):
                        <ul class="pm-created">
                            @foreach (var pm in created)
                            {
                                <li>
                                    <span class="mono">@pm.Id</span> on <a class="mono" href="@UiText.AssetUrl(pm.AssetId)">@pm.AssetId</a>
                                    · @pm.Jobs.Count PM job(s), @pm.Jobs.Sum(j => j.Lines.Count) line(s)
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (decision == ReviewDecision.Pending)
                {
                    var approveTargets = Job.PmModelAssetIds(draft);
                    @if (approveTargets.Count == 0 && !Job.PmModelsWaitForSelection)
                    {
                        <p class="subtle">No asset is selected for this manual. A PM model belongs to an asset, so this draft can only be rejected.</p>
                    }
                    else if (approveTargets.Count > 1)
                    {
                        <p class="subtle">Approving creates this PM model, with the same PM jobs and lines, on all @approveTargets.Count linked assets.</p>
                    }

                    @if (_exists.Contains(draft.Id))
                    {
                        <p class="subtle">This PM model already exists on a linked asset; approving replaces its PM jobs and lines.</p>
                    }
                    <div class="row">
                        <button class="btn btn-primary btn-sm" disabled="@(_busy || approveTargets.Count == 0 || !IngestionJobService.CanReviewPlans(Job))" @onclick="@(() => ApprovePlanAsync(draft))">
                            <Icon Name="check" Size="14" /> @(approveTargets.Count > 1 ? $"Approve & create on {approveTargets.Count} assets" : "Approve & create PM model")
                        </button>
                        <button class="btn btn-sm" disabled="@(_busy || !IngestionJobService.CanReviewPlans(Job))" @onclick="@(() => Jobs.RejectJobPlan(Job, draft))">
                            <Icon Name="x" Size="14" /> Reject
                        </button>
                    </div>
                }
            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger"><Icon Name="alert" /> <div>@_error</div></div>
}

@code {
    [Parameter, EditorRequired] public IngestionJob Job { get; set; } = default!;

    private DocumentProcessingReport? Doc => Job.Document;
    private readonly HashSet<string> _expandedPlans = [];
    private bool _showPlans;
    private readonly HashSet<string> _exists = [];
    private bool _busy;
    private string? _error;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        // Warn up front when approving would replace a PM model created earlier (e.g. the same manual ingested before).
        if (_loadedFor == Job.Id || Doc?.JobPlans is not { Plans.Count: > 0 } plans) return;
        _loadedFor = Job.Id;

        foreach (var plan in plans.Plans)
        {
            try { if (await Jobs.PmModelExistsAsync(Job, plan)) _exists.Add(plan.Id); }
            catch { /* index not created yet: nothing stored */ }
        }
    }

    // "Weekly" -> "every Weekly" reads oddly; only add "every" when the interval does not say it already.
    private static string Every(string interval) =>
        interval.TrimStart().StartsWith("every", StringComparison.OrdinalIgnoreCase) || !char.IsDigit(interval.TrimStart()[0])
            ? interval.Trim()
            : $"every {interval.Trim()}";

    // The title already says there is none: drop the "No PM model:" / "None:" prefix from the reason.
    private static string NoPmReason(string note)
    {
        var colon = note.IndexOf(':');
        var reason = colon > 0 && colon < 15 ? note[(colon + 1)..].Trim() : note.Trim();
        return reason.Length > 0 ? char.ToUpperInvariant(reason[0]) + reason[1..] : reason;
    }

    private void TogglePlan(string id)
    {
        if (!_expandedPlans.Remove(id)) _expandedPlans.Add(id);
    }

    private bool _charBusy;

    private async Task ExtractCharacteristicsAsync() => await RunCharacteristicsAsync(
        () => Jobs.ExtractCharacteristicsAsync(Job), "extract the characteristics");

    private async Task SaveCharacteristicsAsync() => await RunCharacteristicsAsync(
        () => Jobs.SaveCharacteristicsAsync(Job), "save the characteristics");

    // Own busy flag, so a half-minute extraction doesn't block approving PM models meanwhile.
    private async Task RunCharacteristicsAsync(Func<Task> action, string what)
    {
        _charBusy = true;
        _error = null;
        try { await action(); }
        catch (Exception ex) { _error = $"Could not {what}: {ex.Message}"; }
        finally { _charBusy = false; }
    }

    private async Task ApproveProposalAsync() => await RunAsync(() => Jobs.ApproveAssetProposalAsync(Job), "create the assets");

    private async Task ApprovePlanAsync(JobPlan plan) => await RunAsync(() => Jobs.ApproveJobPlanAsync(Job, plan), $"create PM model '{plan.Title}'");

    private async Task RunAsync(Func<Task> action, string what)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        catch (Exception ex) { _error = $"Could not {what}: {ex.Message}"; }
        finally { _busy = false; }
    }

    private static string Format(AssetCharacteristic c) =>
        FormatValue(c.NumericValue, c.BooleanValue, c.TextValue, c.DateValue, c.UnitSymbol ?? c.Unit);

    private static string Format(ExtractedCharacteristic c) =>
        FormatValue(c.NumericValue, c.BooleanValue, c.TextValue, c.DateValue, c.UnitSymbol ?? c.Unit);

    private static string FormatValue(double? number, bool? flag, string? text, string? date, string? unit) =>
        number is { } n ? $"{n:0.###} {unit}".Trim()
        : flag is { } b ? (b ? "Yes" : "No")
        : !string.IsNullOrWhiteSpace(text) ? text
        : date ?? "—";
}
