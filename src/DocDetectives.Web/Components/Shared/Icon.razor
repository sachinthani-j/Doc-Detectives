@* Small inline SVG icon set (stroke icons, 24px grid). *@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "home":
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V20h14V9.5" /><path d="M10 20v-6h4v6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            break;
        case "box":
            <path d="M21 8 12 3 3 8v8l9 5 9-5V8Z" /><path d="m3 8 9 5 9-5" /><path d="M12 13v8" />
            break;
        case "chat":
            <path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.6A8 8 0 1 1 21 12Z" /><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-width="2.6" />
            break;
        case "upload":
            <path d="M12 15V4" /><path d="m7 9 5-5 5 5" /><path d="M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" />
            break;
        case "file":
            <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8l-5-5Z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h4" />
            break;
        case "send":
            <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            break;
        case "stop":
            <rect x="7" y="7" width="10" height="10" rx="1.5" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "alert":
            <path d="M12 9v4" /><path d="M12 17h.01" stroke-width="2.6" /><path d="M10.3 3.9 2.6 17.5A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
            break;
        case "arrow-right":
            <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
            break;
        case "arrow-left":
            <path d="M19 12H5" /><path d="m11 18-6-6 6-6" />
            break;
        case "link":
            <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
            break;
        case "sparkle":
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4" /><path d="m6 6 2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "globe":
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18Z" />
            break;
        case "magnifier-doc":
            <path d="M13 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h5" /><path d="M13 3l5 5v2" /><circle cx="16" cy="16" r="3.2" /><path d="m21 21-2.7-2.7" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
            break;
        case "monitor":
            <rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public double Stroke { get; set; } = 1.8;
}
