{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocDetectives": {
    "ManualsFolder": "C:/path/to/Doc-Detectives/manuals",
    "AutoLinkConfidenceThreshold": 0.85,
    "AutoCreateAssets": true,
    "FoundryContentUnderstanding": {
      "Endpoint": "https://<your-foundry-resource>.services.ai.azure.com/",
      "ApiKey": "<YOUR_CONTENT_UNDERSTANDING_KEY>",
      "AnalyzerId": "prebuilt-layout",
      "ApiVersion": "2025-11-01",
      "PollIntervalSeconds": 2
    },
    "FoundryOpenAI": {
      "Endpoint": "https://<your-foundry-resource>.services.ai.azure.com/",
      "ApiKey": "<YOUR_OPENAI_KEY>",
      "ChatDeployment": "doc-detective-chat-model",
      "EmbeddingDeployment": "text-embedding-3-large"
    },
    "AzureSearch": {
      "Endpoint": "https://<your-search>.search.windows.net",
      "ApiKey": "<YOUR_SEARCH_KEY>",
      "IndexName": "docdetectives-manuals",
      "AssetsIndexName": "docdetectives-assets",
      "AssetKeyField": "key",
      "EmbeddingDimensions": 3072
    }
  }
}
